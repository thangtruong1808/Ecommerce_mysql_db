{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "Backend API for ecommerce application",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --ignore dist --ignore uploads --ext ts,js --exec tsx server.ts",
    "start": "node dist/server.js",
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "keywords": [
    "express",
    "api",
    "ecommerce"
  ],
  "author": "Thang Truong <thangtruong1808@gmail.com>",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.948.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.5",
    "nodemailer": "^6.9.7",
    "pdfkit": "^0.13.0",
    "sharp": "^0.34.5",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^6.4.24",
    "@types/pdfkit": "^0.17.7",
    "nodemon": "^3.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
