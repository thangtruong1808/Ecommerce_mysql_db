# Backend environment sample (placeholders only).
# Copy this file to backend/.env and fill in the secrets there.
# backend/server.js and backend/config/db.js load backend/.env.
# Docker Compose injects that same file into the API container.
# Never commit backend/.env.

# --- Server ---
# development | production | test. Production hides error stacks and marks cookies Secure unless overridden.
NODE_ENV=development
# API port. Defaults to 5000. Docker Compose sets 5000 inside the container.
PORT=5000
# Browser origins allowed by CORS, comma-separated, no trailing slash.
# http://localhost:3000, http://127.0.0.1:3000, and other loopback origins are already allowed in code.
FRONTEND_URL=http://localhost:3000
# Optional extra CORS origins, comma-separated. Example: https://www.example.com,http://localhost:5173
CORS_EXTRA_ORIGINS=

# --- Database (MySQL) ---
# Defaults if unset: localhost, root, empty password, database ecommerce_db.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=ecommerce_db

# --- Auth ---
# Required in production. If empty, the API falls back to an insecure built-in string.
JWT_SECRET=
# jsonwebtoken expiry strings. Defaults: access 5m, refresh 30m.
ACCESS_TOKEN_EXPIRY=5m
REFRESH_TOKEN_EXPIRY=30m
# Cookie Secure flag. true or false. If unset, true when NODE_ENV=production.
COOKIE_SECURE=false
# Cookie SameSite: Lax | Strict | None. If unset, None when Secure, otherwise Lax.
COOKIE_SAMESITE=Lax

# --- Email (Nodemailer) ---
# Password reset and invoice mail. If SMTP_USER or SMTP_PASS is empty, sending is skipped.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true uses TLS from the start (typical for port 465). false uses STARTTLS (typical for 587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=Ecommerce Store
# Absolute URL of the logo in emails. If empty, the app uses FRONTEND_URL/Logo.png.
EMAIL_LOGO_URL=

# --- S3 (media storage; keep when moving hosts) ---
# true stores uploads in S3. Any other value stores files on local disk.
USE_AWS_S3=false
# Used when building object URLs. Defaults to us-east-1.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
# Optional public base URL, no trailing slash. If empty, the SDK URL for the bucket is used.
AWS_S3_BUCKET_URL=

# --- Stripe ---
# Secret key used to create PaymentIntents. Payments are disabled when this is empty.
STRIPE_SECRET_KEY=
# Publishable key returned by GET /api/payments/config. The UI can also use VITE_STRIPE_PUBLISHABLE_KEY.
STRIPE_PUBLISHABLE_KEY=
# Signing secret for POST /api/payments/webhook (direct Stripe webhooks).
STRIPE_WEBHOOK_SECRET=

# --- Australia Post (shipping quotes) ---
# If the API key is empty, checkout uses a flat fallback rate.
AUSPOST_PAC_API_KEY=
# Defaults to the domestic parcel calculate endpoint.
AUSPOST_PAC_BASE_URL=https://digitalapi.auspost.com.au/postage/parcel/domestic/calculate.json
# Origin postcode. Default 3000.
AUSPOST_FROM_POSTCODE=3000
# Parcel defaults used for every quote: kg and centimetres.
AUSPOST_DEFAULT_WEIGHT=1
AUSPOST_DEFAULT_LENGTH=22
AUSPOST_DEFAULT_WIDTH=16
AUSPOST_DEFAULT_HEIGHT=7
AUSPOST_SERVICE_CODE=AUS_PARCEL_REGULAR

# --- AWS Lambda webhook bridge (still in the API) ---
# Shared secret for POST /api/payments/lambda/confirm.
# Leave empty if Stripe calls POST /api/payments/webhook on this API directly.
LAMBDA_WEBHOOK_INTERNAL_SECRET=
