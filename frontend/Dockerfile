FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_API_URL
ARG VITE_STRIPE_PUBLISHABLE_KEY
ARG VITE_SHOWCASE_HOURS_ENABLED
ARG VITE_SHOWCASE_TIMEZONE
ARG VITE_SHOWCASE_HOURS_START
ARG VITE_SHOWCASE_HOURS_END
ARG VITE_SHOWCASE_BUSINESS_DAYS
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_STRIPE_PUBLISHABLE_KEY=${VITE_STRIPE_PUBLISHABLE_KEY}
ENV VITE_SHOWCASE_HOURS_ENABLED=${VITE_SHOWCASE_HOURS_ENABLED}
ENV VITE_SHOWCASE_TIMEZONE=${VITE_SHOWCASE_TIMEZONE}
ENV VITE_SHOWCASE_HOURS_START=${VITE_SHOWCASE_HOURS_START}
ENV VITE_SHOWCASE_HOURS_END=${VITE_SHOWCASE_HOURS_END}
ENV VITE_SHOWCASE_BUSINESS_DAYS=${VITE_SHOWCASE_BUSINESS_DAYS}

RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80
