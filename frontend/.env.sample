# Frontend environment sample (placeholders only).
# Vite reads frontend/.env during `npm run dev` and `npm run build`.
# The frontend Docker image build uses this same file. Only VITE_ names are visible in the browser.
# Do not put secrets here. Never commit frontend/.env.

# --- Public API ---
# Origin of the API, with no trailing /api (the client strips a trailing /api if you include it).
# Leave empty for local Vite: requests use the dev-server proxy to http://localhost:5000.
VITE_API_URL=

# --- Stripe (publishable key only) ---
# Used on the checkout page. Safe to expose. Leave empty to rely on GET /api/payments/config.
VITE_STRIPE_PUBLISHABLE_KEY=

# --- Showcase availability gate ---
# In Vite dev, the gate stays off unless this is true.
# In a production build, the gate stays on unless this is false.
VITE_SHOWCASE_HOURS_ENABLED=false
# IANA timezone. Default Australia/Sydney.
VITE_SHOWCASE_TIMEZONE=Australia/Sydney
# 24-hour local times. Defaults 13:00 and 18:00.
VITE_SHOWCASE_HOURS_START=13:00
VITE_SHOWCASE_HOURS_END=18:00
# Weekdays as numbers, Sunday = 0. Default Monday–Friday.
VITE_SHOWCASE_BUSINESS_DAYS=1,2,3,4,5
